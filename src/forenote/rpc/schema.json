{
  "protocol": "1.0",
  "methods": {
    "system.hello": {
      "params": {
        "type": "object",
        "properties": {
          "protocol": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
          "client": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9._-]+$"}
        },
        "required": ["protocol", "client"],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "protocol": {"type": "string"},
          "engine_version": {"type": "string"}
        },
        "required": ["protocol", "engine_version"]
      }
    },
    "system.status": {
      "params": {"type": "object", "additionalProperties": false},
      "result": {
        "type": "object",
        "properties": {
          "engine_version": {"type": "string"},
          "protocol": {"type": "string"},
          "hardware": {
            "type": "object",
            "required": ["avx2", "physical_cores", "threads", "ram_gib", "tier", "audio_server", "gpus", "problems", "warnings"]
          },
          "tier": {"type": ["string", "null"]},
          "models": {"type": "array"},
          "running_job": {"type": ["integer", "null"]}
        },
        "required": ["engine_version", "protocol", "hardware", "tier", "models", "running_job"]
      }
    },
    "system.shutdown": {
      "params": {"type": "object", "additionalProperties": false},
      "result": {"type": "null"}
    },
    "settings.get": {
      "params": {
        "type": "object",
        "properties": {"key": {"type": "string"}},
        "additionalProperties": false
      },
      "result": {}
    },
    "settings.set": {
      "params": {
        "type": "object",
        "properties": {"key": {"type": "string"}, "value": {}},
        "required": ["key", "value"],
        "additionalProperties": false
      },
      "result": {"type": "null"}
    },
    "jobs.list": {
      "params": {
        "type": "object",
        "properties": {"limit": {"type": "integer", "minimum": 1, "maximum": 500}},
        "additionalProperties": false
      },
      "result": {
        "type": "array",
        "items": {"type": "object", "required": ["id", "type", "status"]}
      }
    },
    "jobs.cancel": {
      "params": {
        "type": "object",
        "properties": {"id": {"type": "integer"}},
        "required": ["id"],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {"cancelled": {"type": "boolean"}},
        "required": ["cancelled"]
      }
    },
    "models.list": {
      "params": {"type": "object", "additionalProperties": false},
      "result": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {"type": "string"},
            "role": {"type": "string"},
            "tiers": {"type": "array", "items": {"type": "string"}},
            "size": {"type": "integer"},
            "installed": {"type": "boolean"}
          },
          "required": ["id", "role", "tiers", "size", "installed"]
        }
      }
    },
    "models.download": {
      "params": {
        "type": "object",
        "properties": {"tier": {"enum": ["low", "default", "high"]}},
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {"job_id": {"type": "integer"}},
        "required": ["job_id"]
      }
    },
    "models.cancel_download": {
      "params": {"type": "object", "additionalProperties": false},
      "result": {
        "type": "object",
        "properties": {"cancelled": {"type": "boolean"}},
        "required": ["cancelled"]
      }
    },
    "models.set_tier": {
      "params": {
        "type": "object",
        "properties": {"tier": {"enum": ["low", "default", "high"]}},
        "required": ["tier"],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {"tier": {"type": "string"}, "installed": {"type": "boolean"}},
        "required": ["tier", "installed"]
      }
    },
    "meeting.start": {
      "params": {
        "type": "object",
        "properties": {
          "title": {"type": "string", "minLength": 1, "maxLength": 200},
          "start_reason": {"enum": ["manual", "detected"]},
          "app": {"type": "string", "minLength": 1, "maxLength": 100},
          "debug_file": {"type": "string", "minLength": 1, "description": "Debug only: needs --debug-sources."}
        },
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {"meeting_id": {"type": "integer"}, "started_at": {"type": "string"}},
        "required": ["meeting_id", "started_at"]
      }
    },
    "meeting.stop": {
      "params": {"type": "object", "additionalProperties": false},
      "result": {
        "type": "object",
        "properties": {"meeting_id": {"type": "integer"}, "status": {"enum": ["recording", "processing", "done", "interrupted"]}},
        "required": ["meeting_id", "status"]
      }
    },
    "meeting.list": {
      "params": {
        "type": "object",
        "properties": {"limit": {"type": "integer", "minimum": 1, "maximum": 500}, "before_id": {"type": "integer"}},
        "additionalProperties": false
      },
      "result": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {"status": {"enum": ["recording", "processing", "done", "interrupted"]}},
          "required": ["id", "title", "started_at", "ended_at", "status", "start_reason", "stop_reason", "line_count"]
        }
      }
    },
    "meeting.get": {
      "params": {
        "type": "object",
        "properties": {"id": {"type": "integer"}},
        "required": ["id"],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {"status": {"enum": ["recording", "processing", "done", "interrupted"]}},
        "required": ["id", "title", "started_at", "ended_at", "status", "start_reason", "stop_reason", "line_count"]
      }
    },
    "meeting.rename": {
      "params": {
        "type": "object",
        "properties": {"id": {"type": "integer"}, "title": {"type": "string", "minLength": 1, "maxLength": 200}},
        "required": ["id", "title"],
        "additionalProperties": false
      },
      "result": {"type": "null"}
    },
    "meeting.delete": {
      "params": {
        "type": "object",
        "properties": {"id": {"type": "integer"}},
        "required": ["id"],
        "additionalProperties": false
      },
      "result": {"type": "null"}
    },
    "meeting.keep_recording": {
      "params": {"type": "object", "additionalProperties": false},
      "result": {
        "type": "object",
        "properties": {"reset": {"type": "boolean"}},
        "required": ["reset"]
      }
    },
    "meeting.dismiss_detection": {
      "params": {
        "type": "object",
        "properties": {"app": {"type": "string", "minLength": 1, "maxLength": 100}},
        "required": ["app"],
        "additionalProperties": false
      },
      "result": {"type": "null"}
    },
    "transcript.get": {
      "params": {
        "type": "object",
        "properties": {
          "meeting_id": {"type": "integer"},
          "after_id": {"type": "integer"},
          "limit": {"type": "integer", "minimum": 1, "maximum": 5000}
        },
        "required": ["meeting_id"],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "lines": {
            "type": "array",
            "items": {"type": "object", "required": ["id", "speaker", "t_start_ms", "t_end_ms", "text"]}
          },
          "markers": {
            "type": "array",
            "items": {"type": "object", "required": ["id", "t_ms", "kind", "speaker"]}
          }
        },
        "required": ["lines", "markers"]
      }
    },
    "notes.add_bullet": {
      "params": {
        "type": "object",
        "properties": {"meeting_id": {"type": "integer"}, "text": {"type": "string", "minLength": 1, "maxLength": 500}},
        "required": ["meeting_id", "text"],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "bullet": {
            "type": "object",
            "properties": {
              "id": {"type": "integer"}, "position": {"type": "integer"}, "text": {"type": "string"},
              "t_written_ms": {"type": ["integer", "null"]}, "enhanced_text": {"type": ["string", "null"]},
              "enhanced_edited": {"type": "boolean"}
            },
            "required": ["id", "position", "text", "t_written_ms", "enhanced_text", "enhanced_edited"]
          }
        },
        "required": ["bullet"]
      }
    },
    "notes.update_bullets": {
      "params": {
        "type": "object",
        "properties": {
          "meeting_id": {"type": "integer"},
          "bullets": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "object",
              "properties": {"id": {"type": "integer"}, "text": {"type": "string", "minLength": 1, "maxLength": 500}},
              "required": ["text"],
              "additionalProperties": false
            }
          }
        },
        "required": ["meeting_id", "bullets"],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "bullets": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "position", "text", "t_written_ms", "enhanced_text", "enhanced_edited"]
            }
          }
        },
        "required": ["bullets"]
      }
    },
    "notes.get": {
      "params": {
        "type": "object",
        "properties": {"meeting_id": {"type": "integer"}},
        "required": ["meeting_id"],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "bullets": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "position", "text", "t_written_ms", "enhanced_text", "enhanced_edited"]
            }
          },
          "summary": {"type": ["string", "null"]},
          "action_items": {
            "type": ["array", "null"],
            "items": {
              "type": "object",
              "properties": {"owner": {"type": ["string", "null"]}, "text": {"type": "string"}},
              "required": ["owner", "text"]
            }
          },
          "model": {"type": ["string", "null"]},
          "mode": {"enum": ["prefix", "map_reduce", null]},
          "created_at": {"type": ["string", "null"]},
          "job": {
            "type": ["object", "null"],
            "properties": {"id": {"type": "integer"}, "status": {"enum": ["pending", "running", "done", "failed", "cancelled"]}},
            "required": ["id", "status"]
          }
        },
        "required": ["bullets", "summary", "action_items", "model", "mode", "created_at", "job"]
      }
    },
    "notes.enhance": {
      "params": {
        "type": "object",
        "properties": {"meeting_id": {"type": "integer"}, "force": {"type": "boolean"}},
        "required": ["meeting_id"],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {"job_id": {"type": "integer"}},
        "required": ["job_id"]
      }
    },
    "notes.update_enhanced": {
      "params": {
        "type": "object",
        "properties": {"bullet_id": {"type": "integer"}, "text": {"type": "string", "maxLength": 2000}},
        "required": ["bullet_id", "text"],
        "additionalProperties": false
      },
      "result": {"type": "object", "additionalProperties": false}
    },
    "library.add_folder": {
      "params": {
        "type": "object",
        "properties": {"path": {"type": "string", "minLength": 1}},
        "required": ["path"],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "folder_id": {"type": "integer"},
          "added": {"type": "boolean"},
          "pending": {"type": "integer", "minimum": 0},
          "job_id": {"type": ["integer", "null"]}
        },
        "required": ["folder_id", "added", "pending", "job_id"]
      }
    },
    "library.list": {
      "params": {"type": "object", "additionalProperties": false},
      "result": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {"type": "integer"},
            "path": {"type": "string"},
            "status": {"enum": ["ok", "missing"]},
            "counts": {
              "type": "object",
              "properties": {
                "indexed": {"type": "integer"},
                "pending": {"type": "integer"},
                "error": {"type": "integer"},
                "skipped": {"type": "integer"}
              },
              "required": ["indexed", "pending", "error", "skipped"]
            }
          },
          "required": ["id", "path", "status", "counts"]
        }
      }
    }
  },
  "events": {
    "job.progress": {
      "type": "object",
      "properties": {
        "id": {"type": "integer"},
        "type": {"type": "string"},
        "message": {"type": "string"},
        "fraction": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "required": ["id", "type", "message"]
    },
    "job.done": {
      "type": "object",
      "properties": {"id": {"type": "integer"}, "type": {"type": "string"}, "status": {"enum": ["done", "cancelled"]}},
      "required": ["id", "type", "status"]
    },
    "job.failed": {
      "type": "object",
      "properties": {"id": {"type": "integer"}, "type": {"type": "string"}, "error": {"type": "string"}},
      "required": ["id", "type", "error"]
    },
    "models.progress": {
      "type": "object",
      "properties": {
        "model": {"type": "string"},
        "file": {"type": "string"},
        "index": {"type": "integer"},
        "count": {"type": "integer"}
      },
      "required": ["model", "file", "index", "count"]
    },
    "engine.error": {
      "type": "object",
      "properties": {"message": {"type": "string"}},
      "required": ["message"]
    },
    "meeting.state": {
      "description": "Clients ignore events for a meeting id they do not know (a failed start can emit them).",
      "type": "object",
      "properties": {
        "meeting_id": {"type": "integer"},
        "status": {"enum": ["recording", "processing", "done"]},
        "stop_reason": {"enum": ["manual", "silence", "error"]}
      },
      "required": ["meeting_id", "status"]
    },
    "notes.delta": {
      "type": "object",
      "properties": {
        "meeting_id": {"type": "integer"},
        "part": {"enum": ["bullet", "summary", "action_items"]},
        "bullet_id": {"type": "integer"},
        "text": {"type": "string"}
      },
      "required": ["meeting_id", "part", "text"]
    },
    "notes.done": {
      "type": "object",
      "properties": {"meeting_id": {"type": "integer"}, "status": {"enum": ["done", "failed", "cancelled"]}},
      "required": ["meeting_id", "status"]
    },
    "meeting.detected": {
      "type": "object",
      "properties": {"app": {"type": "string"}},
      "required": ["app"]
    },
    "meeting.auto_stop_pending": {
      "type": "object",
      "properties": {"meeting_id": {"type": "integer"}, "seconds_left": {"type": "integer"}},
      "required": ["meeting_id", "seconds_left"]
    },
    "transcript.partial": {
      "type": "object",
      "properties": {
        "meeting_id": {"type": "integer"},
        "speaker": {"enum": ["me", "others"]},
        "t_start_ms": {"type": "integer"},
        "text": {"type": "string"}
      },
      "required": ["meeting_id", "speaker", "t_start_ms", "text"]
    },
    "transcript.final": {
      "type": "object",
      "properties": {
        "meeting_id": {"type": "integer"},
        "id": {"type": "integer"},
        "speaker": {"enum": ["me", "others"]},
        "t_start_ms": {"type": "integer"},
        "t_end_ms": {"type": "integer"},
        "text": {"type": "string"}
      },
      "required": ["meeting_id", "id", "speaker", "t_start_ms", "t_end_ms", "text"]
    },
    "audio.source_changed": {
      "type": "object",
      "properties": {"meeting_id": {"type": "integer"}, "speaker": {"enum": ["me", "others"]}, "device": {"type": "string"}},
      "required": ["meeting_id", "speaker", "device"]
    },
    "audio.source_lost": {
      "type": "object",
      "properties": {"meeting_id": {"type": "integer"}, "speaker": {"enum": ["me", "others"]}, "reason": {"type": "string"}},
      "required": ["meeting_id", "speaker", "reason"]
    },
    "asr.delayed": {
      "type": "object",
      "properties": {"meeting_id": {"type": "integer"}, "delayed": {"type": "boolean"}, "queued_s": {"type": "number"}},
      "required": ["meeting_id", "delayed", "queued_s"]
    }
  }
}
